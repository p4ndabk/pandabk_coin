PORT=8080
DB_DRIVER=sqlite
DB_PATH=data/base_project.db
# DB_DSN is only used when DB_DRIVER=postgres, e.g.:
# DB_DSN=host=localhost user=postgres password=postgres dbname=base_project port=5432 sslmode=disable
DB_DSN=
JWT_SECRET=change-me-in-production
# "*" allows any origin; otherwise a comma-separated allowlist, e.g.
# CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
