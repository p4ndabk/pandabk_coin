# panda.conf — configuração do NODE em execução (quem RODA a PANDA).
# Não confundir com o build.conf, que é do desenvolvedor que COMPILA o
# binário (veja build.conf.example) — responsabilidades separadas.
#
# Copie para panda.conf no diretório onde você roda o node; os comandos o
# encontram sozinhos (ou aponte outro caminho com -config).
#
# Formato: chave=valor, uma por linha, # comenta. As chaves são exatamente
# os nomes dos flags — qualquer flag passado na linha de comando VENCE o
# valor daqui. Cada subcomando usa só as chaves que conhece e ignora o
# resto (dá para manter node run e powdemo no mesmo arquivo).

# ── node run (o full node de verdade) ──────────────────────────────────────

# onde vivem chain.db e wallet.json (default: ~/.panda)
#datadir=/home/voce/.panda

# porta P2P para outros nodes; vazio = só conexões de saída (atrás de NAT)
listen=:9551

# nodes que você conhece, host:porta separados por vírgula (a descoberta de
# peers propaga o resto); `peer=` é atalho para um único
#peers=192.168.1.10:9551

# RPC local dos comandos info/balance/send (obrigatoriamente loopback)
#rpc=127.0.0.1:8555

# mineração LIGADA por padrão (todo node contribui); mine=false desliga
#mine=true

# workers de mineração (1 core e ~64 MiB de RAM cada)
#miners=1

# perfil de consenso: devnet (Argon2 64 MiB) ou test (1 MiB, só para testes)
#profile=devnet

# ── bancada didática (powdemo/blocks/ranking) ──────────────────────────────

# identidade do minerador (aparece nos logs e no placar)
name=David

# cópia local da chain da demo (obrigatória para listen/peer)
db=david.db

# node remoto da demo com quem reconciliar
#peer=192.168.1.10:9551

# regras da corrida — os DOIS lados de um par listen/peer precisam usar as
# mesmas (cada máquina tem seu próprio banco, não há adoção automática)
spacing=1m
zeros=10
retarget=10

# 0 = minerar sem parar, até Ctrl+C
blocks=0

# goroutines de mineração da demo (1 core e ~64 MiB de RAM cada)
#workers=1
